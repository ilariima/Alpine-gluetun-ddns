# Copy this file to endpoint.env in the Gluetun stack directory on the host.
#
# This file holds ONLY the endpoint address. Keep the WireGuard private key,
# public key, port, addresses and every other Gluetun setting in the stack's
# main .env.
#
# Gluetun must list this file AFTER .env in env_file, so this value wins:
#
#   env_file:
#     - .env
#     - endpoint.env
#
# Set the current address once by hand; the watcher maintains it from then on.
WIREGUARD_ENDPOINT_IP=203.0.113.10
