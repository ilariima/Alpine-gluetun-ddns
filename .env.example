# Paste this into Dockhand's environment editor for the watcher stack.
#
# Step 1 of the README fills in everything except DDNS_HOST, which is the
# one value your host cannot know. The block below is in the same order
# the script prints, so you can paste its output straight over this.
#
# Keep the quotes around any value containing spaces.

DDNS_HOST=CHANGE_ME.example.com
GLUETUN_STACK_DIR_HOST="/paste/from/step/1"
DOCKHAND_STACK=gluetun
DOCKHAND_NETWORK=dockhand_socket-proxy
DOCKHAND_ENV_NAME="CHANGE_ME"

# About DOCKHAND_NETWORK: every Dockhand install has a
# dockhand_socket-proxy network and Dockhand is on it, so it is shown here
# as a value that works anywhere. If Dockhand is also on another network,
# step 1 will suggest that one instead, and it is the better choice: the
# watcher never needs to talk to a Docker socket proxy, so there is no
# reason for it to sit on a network where one is reachable.

# ---------------------------------------------------------------------
# Everything below is optional. The value shown is the default that
# applies if you leave the line out entirely.
# ---------------------------------------------------------------------

# Only if Dockhand authentication is turned on:
#DOCKHAND_TOKEN=

# Where Dockhand is, as seen from inside the watcher container:
#DOCKHAND_URL=http://dockhand:3000

# Use a numeric environment id instead of the name:
#DOCKHAND_ENV_ID=

# Which variable to keep updated, and which file in the stack directory
# to edit. See "keep the watcher away from your keys" in the README.
#TARGET_VARIABLE=WIREGUARD_ENDPOINT_IP
#TARGET_ENV_FILENAME=.env

# Seconds between DNS checks:
#CHECK_INTERVAL=60

# Seconds before the first check, and allowed for one deploy request:
#STARTUP_DELAY=15
#DEPLOY_TIMEOUT=300

# Longest wait between failed deploy attempts:
#MAX_DEPLOY_BACKOFF=900

# Container name and base image:
#SIDECAR_CONTAINER_NAME=gluetun-ddns
#WATCHER_IMAGE=alpine:latest
