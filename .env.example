# Copy this file to .env and fill in the values for your installation.
# Every setting below is installation-specific; compose.yaml itself is portable.

# --- watcher ------------------------------------------------------------

# Name for the watcher container itself.
SIDECAR_CONTAINER_NAME=gluetun-ddns

# Base image. alpine:latest keeps the watcher current; pin it
# (for example alpine:3.24) if you would rather control when it moves.
WATCHER_IMAGE=alpine:latest

# The DDNS hostname to follow. Must have an IPv4 A record.
DDNS_HOST=your-hostname.example.com

# Seconds between DNS checks.
CHECK_INTERVAL=60

# Seconds to wait before the first check, so Dockhand is up first.
STARTUP_DELAY=15

# Seconds to allow a single Dockhand deploy request to run.
DEPLOY_TIMEOUT=300

# Upper bound, in seconds, for the wait between failed deploy attempts.
# Failures back off 1x, 2x, 4x ... CHECK_INTERVAL up to this ceiling, so a
# prolonged Dockhand outage cannot mean a force-recreate every cycle for
# hours. DNS is still polled every CHECK_INTERVAL throughout, and a new
# address clears the backoff at once.
MAX_DEPLOY_BACKOFF=900

# --- target file --------------------------------------------------------

# The variable the watcher rewrites. Change only if your target
# configuration uses a different name.
TARGET_VARIABLE=WIREGUARD_ENDPOINT_IP

# Absolute path ON THE DOCKER HOST to the endpoint.env that Gluetun loads.
# Quote it if the path contains spaces. README section 3 explains how to
# derive this from Dockhand's mounts.
TARGET_ENV_FILE_HOST="/absolute/host/path/to/the/gluetun/stack/endpoint.env"

# --- dockhand -----------------------------------------------------------

# Dockhand's address as seen from inside the watcher container.
DOCKHAND_URL=http://dockhand:3000

# An existing Docker network that Dockhand is attached to.
DOCKHAND_NETWORK=your_dockhand_network

# The environment name exactly as shown in Dockhand, including spaces
# and capitalization. Quote it if it contains spaces.
# Normally set this and leave DOCKHAND_ENV_ID empty.
DOCKHAND_ENV_NAME="Your Environment"

# Optional numeric environment id. If set, it wins and no lookup is made.
DOCKHAND_ENV_ID=

# The Compose project name of the Gluetun stack. The watcher refuses to
# start if this names its own stack, which would redeploy itself in a loop.
DOCKHAND_STACK=gluetun

# Leave empty if Dockhand authentication is disabled.
# Otherwise a Dockhand API token (dh_...).
DOCKHAND_TOKEN=
